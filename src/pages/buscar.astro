---
/** Página de búsqueda: pasa las notas y los filtros al buscador. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchApp from '../components/search/SearchApp.astro';
import type { SearchDoc } from '../components/search/search';
import { ASIGNATURAS, SECTIONS, TIPOS, type SectionId } from '../data/site';
import { getAllEntries } from '../lib/entries';
import { url } from '../lib/url';

const docs: SearchDoc[] = (await getAllEntries()).map((e) => ({
  slug: e.slug,
  section: e.section,
  sectionLabel: SECTIONS[e.section].label,
  title: e.title,
  tipoLabel: TIPOS[e.tipo].label,
  asignaturas: e.asignaturas,
  tags: e.tags,
  description: e.description,
  href: e.href,
}));

const asignaturas = ASIGNATURAS.map((a) => ({ id: a.id, label: a.corto, title: a.nombre, color: a.color }));
const sections = (Object.keys(SECTIONS) as SectionId[]).map((id) => ({ id, label: SECTIONS[id].label }));
---

<BaseLayout title="Buscar" description="Busca conceptos, herramientas, comandos y casos prácticos.">
  <div class="container page search-page">
    <header class="page-header">
      <p class="eyebrow">~/buscar · pulsa <kbd>/</kbd> en cualquier página</p>
      <h1 class="prompt">grep -ri</h1>
    </header>

    <SearchApp
      docs={docs}
      asignaturas={asignaturas}
      sections={sections}
      indexUrl={url('/search-index.json')}
    />
  </div>
</BaseLayout>

<style>
  .search-page {
    max-width: 52rem;
  }
</style>
