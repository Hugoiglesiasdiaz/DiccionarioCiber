---
/** Listado de una sección (conceptos, herramientas o casos) con filtros. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterableList from '../../components/FilterableList.astro';
import { SECTIONS, type SectionId } from '../../data/site';
import { SECTION_IDS, getEntries } from '../../lib/entries';

export function getStaticPaths() {
  return SECTION_IDS.map((section) => ({ params: { section } }));
}

const section = Astro.params.section as SectionId;
const info = SECTIONS[section];
const entries = await getEntries(section);
---

<BaseLayout title={info.label} description={info.intro}>
  <div class="container page">
    <header class="page-header">
      <p class="eyebrow">~/{section} · {entries.length} {entries.length === 1 ? 'nota' : 'notas'}</p>
      <h1 class="prompt">ls {section}/</h1>
      <p>{info.intro}</p>
    </header>

    <FilterableList entries={entries} />
  </div>
</BaseLayout>
