---
/** Página de una nota, generada desde su archivo Markdown. */
import { render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { REQUIRED_SECTIONS } from '../../data/site';
import { SECTION_IDS, getAllEntries, getRaw, getRelated, toEntry, type RawEntry } from '../../lib/entries';
import { getTemaNav } from '../../lib/temas';

export async function getStaticPaths() {
  const lists = await Promise.all(SECTION_IDS.map(getRaw));
  return lists.flat().map((raw) => ({
    params: { section: raw.collection, slug: raw.id },
    props: { raw },
  }));
}

const { raw } = Astro.props as { raw: RawEntry };
const entry = toEntry(raw);
const { Content, headings } = await render(raw);
const all = await getAllEntries();
const temaNav = getTemaNav(entry, all);
// Las vecinas del tema ya se enlazan abajo: no se repiten en "relacionadas".
const vecinas = new Set([temaNav?.anterior?.href, temaNav?.siguiente?.href]);
const related = getRelated(
  entry,
  all.filter((e) => !vecinas.has(e.href)),
);

// El índice se construye con los títulos de nivel 2 (##).
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text }));

// Aviso en el build si la nota no sigue la plantilla de su tipo.
const normalize = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
const missing = REQUIRED_SECTIONS[entry.tipo].filter(
  (req) => !toc.some((t) => normalize(t.label).startsWith(normalize(req))),
);
if (missing.length > 0) {
  console.warn(`[plantilla] ${raw.filePath}: faltan las secciones ${missing.map((m) => `"## ${m}"`).join(', ')}`);
}
---

<EntryLayout entry={entry} toc={toc} related={related} temaNav={temaNav}>
  <Content />
</EntryLayout>
