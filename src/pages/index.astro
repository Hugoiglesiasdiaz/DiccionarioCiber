---
/**
 * Inicio: buscador grande, terminal decorativa, accesos por asignatura y
 * últimas notas.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import Icon from '../components/Icon.astro';
import { ASIGNATURAS, SITE } from '../data/site';
import { getAllEntries } from '../lib/entries';
import { url } from '../lib/url';

const ENTRIES = await getAllEntries();

/** Una tarjeta por asignatura con el número de conceptos y casos. */
const asignaturas = ASIGNATURAS.map((a) => {
  const notas = ENTRIES.filter((e) => e.asignaturas.includes(a.id));
  return {
    ...a,
    conceptos: notas.filter((e) => e.section === 'conceptos').length,
    casos: notas.filter((e) => e.section === 'casos').length,
    total: notas.length,
    href: url(`/buscar/?asignatura=${a.id}`),
  };
});

const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;
---

<BaseLayout>
  <!-- Hero con buscador -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="eyebrow">// {SITE.tagline}</p>
        <h1 class="hero__title">
          Conceptos, herramientas y comandos de <span class="hero__name">ciberseguridad</span>, a
          mano.
        </h1>

        <!-- Formulario normal: funciona sin JS y lleva a /buscar/?q=… -->
        <form class="hero-search" action={url('/buscar/')} method="get" role="search">
          <label for="hero-q" class="visually-hidden">Buscar en las notas</label>
          <span class="hero-search__prompt" aria-hidden="true">❯</span>
          <input
            id="hero-q"
            name="q"
            type="search"
            class="hero-search__input"
            placeholder="nmap, cadena de custodia, --pid…"
            autocomplete="off"
            spellcheck="false"
            data-search-input
          />
          <button class="hero-search__button" type="submit" aria-label="Buscar">
            <Icon name="search" size={18} />
          </button>
        </form>

        <p class="hero__lead">
          Lo que voy aprendiendo en el curso, organizado por asignatura. Pulsa <kbd>/</kbd> para
          buscar desde cualquier página.
        </p>
      </div>

      <div class="terminal hero__terminal" aria-hidden="true">
        <div class="terminal__bar">
          <span class="terminal__dot"></span><span class="terminal__dot"></span><span class="terminal__dot"></span>
          <span class="terminal__title">bash — 80×24</span>
        </div>
        <div class="terminal__body">
          <p class="cmd">cat README</p>
          <p class="out">apuntes de ciberseguridad · consulta rápida</p>
          <p class="cmd">ls ~/ciber</p>
          <p class="out">
            <span style="color: var(--cyan)">conceptos/</span>&nbsp;
            <span style="color: var(--cyan)">casos/</span>
          </p>
          <p class="cmd">grep -ri "volatility" .</p>
          <p class="out">conceptos/volatility.md: <span style="color: var(--green)">windows.pslist</span></p>
          <p class="cmd"><span class="cursor"></span></p>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <!-- Accesos por asignatura -->
    <section class="section" aria-labelledby="asignaturas">
      <div class="section-title">
        <h2 id="asignaturas" class="hash">Asignaturas</h2>
      </div>
      <ul class="grid grid--3 subjects">
        {
          asignaturas.map((a) => (
            <li class={`card subject ${a.total > 0 ? 'card--link' : 'subject--empty'}`} style={`--c: ${a.color}`}>
              <span class="subject__short mono">{a.corto}</span>
              <h3 class="subject__name">
                {a.total > 0 ? (
                  <a class="card__link" href={a.href}>
                    {a.nombre}
                  </a>
                ) : (
                  a.nombre
                )}
              </h3>
              <p class="subject__count mono">
                {a.total > 0
                  ? `${plural(a.conceptos, 'concepto', 'conceptos')} · ${plural(a.casos, 'caso', 'casos')} →`
                  : 'sin notas todavía'}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Últimas notas -->
    <section class="section" aria-labelledby="recientes">
      <div class="section-title">
        <h2 id="recientes" class="hash">Últimas notas</h2>
        <a href={url('/conceptos/')}>ver todo →</a>
      </div>
      <div class="grid grid--3">
        {ENTRIES.slice(0, 6).map((entry) => <EntryCard entry={entry} />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-6) var(--space-7);
  }

  .hero__text {
    display: grid;
    /* minmax(0, 1fr): el input no debe ensanchar la columna en el móvil */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-content: center;
  }

  .hero__title {
    font-size: clamp(1.6rem, 1.1rem + 2vw, 2.4rem);
  }

  .hero__name {
    color: var(--green);
  }

  .hero__lead {
    max-width: 52ch;
    color: var(--muted);
  }

  /* Buscador grande */
  .hero-search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-left: var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--input-bg);
    box-shadow: var(--shadow);
    transition:
      border-color 0.15s var(--ease),
      box-shadow 0.15s var(--ease);
  }

  .hero-search:focus-within {
    border-color: var(--green);
    box-shadow: var(--glow-green);
  }

  .hero-search__prompt {
    color: var(--green);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .hero-search__input {
    flex: 1;
    min-width: 0;
    height: 3.5rem;
    border: 0;
    outline: 0;
    background: none;
    color: var(--text-strong);
    font-family: var(--font-mono);
    font-size: max(1rem, var(--fs-lg));
    caret-color: var(--green);
  }

  .hero-search__input::placeholder {
    color: var(--faint);
  }

  .hero-search__button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: 0.35rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--green);
    color: var(--on-accent);
  }

  .hero-search__button:hover {
    background: var(--green-hover);
  }

  @media (min-width: 64rem) {
    .hero__inner {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-7);
      padding-block: var(--space-8);
    }
  }

  /* Tarjetas de asignatura */
  .subjects {
    padding: 0;
    list-style: none;
  }

  .subject {
    gap: var(--space-2);
    border-top: 3px solid var(--c);
  }

  .subject__short {
    color: var(--c);
    font-size: var(--fs-xs);
    font-weight: 700;
  }

  .subject__name {
    flex: 1;
    font-size: var(--fs-lg);
  }

  .subject__count {
    color: var(--muted);
    font-size: var(--fs-xs);
  }

  .subject--empty {
    opacity: 0.55;
  }

  .subject--empty .subject__name {
    color: var(--muted);
  }
</style>
