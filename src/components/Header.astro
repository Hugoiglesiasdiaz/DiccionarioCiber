---
/**
 * Cabecera fija con logo y navegación.
 * - Escritorio: navegación horizontal en la propia cabecera.
 * - Móvil: la navegación pasa a una barra inferior fija (más cómoda con el pulgar).
 */
import Icon from './Icon.astro';
import { NAV, SITE } from '../data/site';
import { isActive, url } from '../lib/url';

const current = Astro.url.pathname;
---

<header class="header">
  <div class="container header__inner">
    <a class="logo" href={url('/')} aria-label={`${SITE.name}, inicio`}>
      <span class="logo__user">root@ciber</span><span class="logo__sep">:</span><span
        class="logo__path">{SITE.handle}</span
      ><span class="logo__caret">$</span>
    </a>

    <nav class="nav" aria-label="Principal">
      <ul>
        {
          NAV.filter((item) => item.icon !== 'search').map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(current, item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="header__search" href={url('/buscar/')} aria-label="Buscar">
      <Icon name="search" size={18} />
      <span class="header__search-text">Buscar</span>
      <kbd class="header__kbd">/</kbd>
    </a>

    <!-- Se ve el icono del tema al que se cambia: sol en oscuro, luna en claro. -->
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Cambiar de tema">
      <Icon name="sun" size={18} class="theme-toggle__sun" />
      <Icon name="moon" size={18} class="theme-toggle__moon" />
    </button>
  </div>
</header>

<nav class="bottom-nav" aria-label="Principal (móvil)">
  <ul>
    {
      NAV.map((item) => (
        <li>
          <a href={url(item.href)} aria-current={isActive(current, item.href) ? 'page' : undefined}>
            <Icon name={item.icon} size={22} />
            <span>{item.short ?? item.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // Atajo de teclado "/" para ir al buscador (como en GitHub o MDN).
  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    const typing = target.closest('input, textarea, select, [contenteditable="true"]');
    if (event.key !== '/' || typing || event.metaKey || event.ctrlKey) return;

    const input = document.querySelector<HTMLInputElement>('[data-search-input]');
    event.preventDefault();
    if (input) input.focus();
    else window.location.href = document.querySelector<HTMLAnchorElement>('.header__search')!.href;
  });

  // Botón de tema claro / oscuro. El tema inicial lo pone el script del <head>.
  type Theme = 'light' | 'dark';
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const systemLight = matchMedia('(prefers-color-scheme: light)');

  function setTheme(theme: Theme) {
    root.dataset.theme = theme;
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content =
      theme === 'light' ? '#f6f8fa' : '#090d12';
    toggle.setAttribute('aria-label', theme === 'light' ? 'Cambiar a tema oscuro' : 'Cambiar a tema claro');
    toggle.title = toggle.getAttribute('aria-label')!;
  }

  setTheme(root.dataset.theme === 'light' ? 'light' : 'dark');

  toggle.addEventListener('click', () => {
    const next: Theme = root.dataset.theme === 'light' ? 'dark' : 'light';
    setTheme(next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Navegación privada o almacenamiento bloqueado: el cambio dura hasta recargar.
    }
  });

  // Si nunca se ha elegido tema a mano, sigue los cambios del sistema en vivo.
  systemLight.addEventListener('change', (event) => {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem('theme');
    } catch {}
    if (!saved) setTheme(event.matches ? 'light' : 'dark');
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: var(--bar-bg);
    backdrop-filter: blur(10px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--header-h);
  }

  .logo {
    display: inline-flex;
    align-items: baseline;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .logo__user {
    color: var(--green);
  }

  .logo__sep {
    color: var(--muted);
  }

  .logo__path {
    color: var(--cyan);
  }

  .logo__caret {
    margin-left: 0.4ch;
    color: var(--text);
  }

  .nav {
    display: none;
  }

  .nav ul {
    display: flex;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: block;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--text);
    background: var(--surface);
  }

  .nav a[aria-current='page'] {
    color: var(--green);
  }

  .nav a[aria-current='page']::before {
    content: './';
    color: var(--faint);
  }

  .header__search {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
    padding: 0.4rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--muted);
    text-decoration: none;
  }

  .header__search:hover {
    color: var(--text);
  }

  .header__search-text,
  .header__kbd {
    display: none;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--muted);
  }

  .theme-toggle:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .theme-toggle :global(.theme-toggle__moon),
  :global(:root[data-theme='light']) .theme-toggle :global(.theme-toggle__sun) {
    display: none;
  }

  :global(:root[data-theme='light']) .theme-toggle :global(.theme-toggle__moon) {
    display: block;
  }

  /* Barra inferior (solo móvil) */
  .bottom-nav {
    position: fixed;
    inset: auto 0 0;
    z-index: 50;
    border-top: 1px solid var(--border);
    background: var(--bar-bg);
    backdrop-filter: blur(10px);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .bottom-nav ul {
    display: grid;
    /* Tantas columnas iguales como elementos tenga NAV */
    grid-auto-columns: 1fr;
    grid-auto-flow: column;
    height: var(--bottom-nav-h);
    padding: 0;
    list-style: none;
  }

  .bottom-nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    height: 100%;
    color: var(--faint);
    /* Sans en vez de mono: "Herramientas" cabe en 1/5 de 320px */
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 500;
    text-decoration: none;
  }

  .bottom-nav a[aria-current='page'] {
    color: var(--green);
  }

  .bottom-nav a[aria-current='page'] :global(svg) {
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--green) 50%, transparent));
  }

  @media (min-width: 48rem) {
    .nav {
      display: block;
    }

    .bottom-nav {
      display: none;
    }

    .header__search {
      min-width: 12rem;
      padding: 0.35rem 0.6rem;
      border-color: var(--border);
      background: var(--surface);
      font-size: var(--fs-sm);
    }

    .header__search:hover {
      border-color: var(--border-strong);
    }

    .header__search-text {
      display: inline;
      font-family: var(--font-mono);
    }

    .header__kbd {
      display: inline;
      margin-left: auto;
    }
  }
</style>
