---
/** Tarjeta de una nota (concepto, herramienta o caso práctico) en un listado. */
import type { Entry } from '../lib/entries';
import { EXTRAS, TIPOS } from '../data/site';
import AsignaturaBadges from './AsignaturaBadges.astro';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const date = new Date(entry.updated).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
// "Herramienta" ya se ve como tipo de nota; aquí solo el resto de extras.
const extras = EXTRAS.filter((x) => entry.extras.includes(x.id));
---

<article
  class="card card--link entry"
  data-asignaturas={entry.asignaturas.join(' ')}
  data-extras={entry.extras.join(' ')}
>
  <div class="entry__meta">
    <span class={`entry__tipo entry__tipo--${entry.tipo}`}>{TIPOS[entry.tipo].label}</span>
    <time class="entry__date" datetime={entry.updated}>{date}</time>
  </div>

  <h3 class="entry__title">
    <a class="card__link" href={entry.href}>{entry.title}</a>
  </h3>

  <p class="entry__desc">{entry.description}</p>

  <div class="entry__footer">
    <AsignaturaBadges ids={entry.asignaturas} />
    {
      extras.length > 0 && (
        <ul class="tags" aria-label="Filtros extra">
          {extras.map((x) => (
            <li class="tag">{x.label}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .entry__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .entry__tipo {
    color: var(--faint);
  }

  .entry__tipo::before {
    content: '[';
  }

  .entry__tipo::after {
    content: ']';
  }

  .entry__tipo--herramienta {
    color: var(--cyan);
  }

  .entry__tipo--caso {
    color: var(--green);
  }

  .entry__date {
    color: var(--faint);
  }

  .entry__title {
    font-size: var(--fs-lg);
  }

  .entry__desc {
    flex: 1;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .entry__footer {
    display: grid;
    gap: var(--space-2);
  }
</style>
