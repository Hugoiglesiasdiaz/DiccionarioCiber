---
/** Tarjeta de una entrada (herramienta, writeup o apunte) en un listado. */
import type { Entry } from '../lib/entries';
import { SECTIONS, getCategory } from '../data/site';

interface Props {
  entry: Entry;
  /** Muestra la sección (útil en listados mixtos como "Últimas entradas"). */
  showSection?: boolean;
}

const { entry, showSection = false } = Astro.props;
const category = getCategory(entry.category);
const section = SECTIONS[entry.section];
const href = entry.href;
const date = new Date(entry.updated).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
---

<article class="card card--link entry" data-category={entry.category}>
  <div class="entry__meta">
    <span class="badge" style={`--c: ${category.color}`}>{category.label}</span>
    {showSection && <span class="entry__section">{section.label.toLowerCase()}/</span>}
  </div>

  <h3 class="entry__title">
    <a class="card__link" href={href}>{entry.title}</a>
  </h3>

  <p class="entry__desc">{entry.description}</p>

  <div class="entry__footer">
    <ul class="tags" aria-label="Etiquetas">
      {entry.tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    <time class="entry__date" datetime={entry.updated}>{date}</time>
  </div>
</article>

<style>
  .entry__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .entry__section {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .entry__title {
    font-size: var(--fs-lg);
  }

  .entry__desc {
    flex: 1;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .entry__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .entry__date {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
</style>
